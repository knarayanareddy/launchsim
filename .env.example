# ---------------------------------------------------------------------------
# Frontend (Vite) — safe to expose, but the project still needs correct RLS.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Public origin used for canonical URLs, OG tags and referral links.
# Falls back to window.location.origin when unset.
VITE_APP_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Edge function secrets (set with `supabase secrets set`, never in the repo)
# ---------------------------------------------------------------------------
# LOVABLE_API_KEY=...
# RESEND_API_KEY=...
# EMAIL_FROM="LaunchSim <noreply@yourdomain.com>"
# APP_URL=https://your-domain.com
# ALLOWED_ORIGINS=https://your-domain.com,https://staging.your-domain.com

# ---------------------------------------------------------------------------
# Local Supabase CLI (auto-provided by `supabase start`)
# ---------------------------------------------------------------------------
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
